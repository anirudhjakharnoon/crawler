# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build the descriptive User-Agent + /about-crawlr link (lib/robots.ts)
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app

# Optional: shared secret required by cron routes so they can't be triggered by randoms.
# Vercel Cron automatically sends this as a Bearer token when CRON_SECRET is set in
# your Vercel project env vars — see README "Cron" section.
CRON_SECRET=change-me
