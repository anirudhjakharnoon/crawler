# Public — safe to expose to the browser.
# NEXT_PUBLIC_SUPABASE_URL is your project's "Project URL" (Supabase dashboard
# → the "Connect" button, or Settings → Data API) — it's a real https:// URL,
# NOT an API key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY: on newer Supabase projects this is labeled
# "Publishable key" (starts with sb_publishable_...) instead of the older
# "anon key" (a long eyJ... JWT) — either format goes here, under this same
# variable name. Find it in Settings → API Keys (or the "Connect" dialog).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the client.
# On newer Supabase projects this is labeled "Secret key" (sb_secret_...)
# instead of the older "service_role key" (a long eyJ... JWT) — either
# format goes here, under this same variable name. Settings → API Keys.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Used to build the descriptive User-Agent + /about-crawlr link (lib/robots.ts)
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app

# Optional: shared secret required by cron routes so they can't be triggered by randoms.
# Vercel Cron automatically sends this as a Bearer token when CRON_SECRET is set in
# your Vercel project env vars — see README "Cron" section.
CRON_SECRET=change-me

# Optional, defaults to off. Set to exactly "true" to enable the opt-in
# headless-rendering fallback for pages that are pure client-side-rendered
# SPAs with no content in their static HTML — read README §3.3 first, this
# has real cost/latency tradeoffs and is NOT needed for ordinary sites.
ENABLE_JS_RENDERING=false
